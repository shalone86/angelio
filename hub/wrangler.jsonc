{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "angelio",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Each app is its own Worker; the hub forwards angelio.org/<path>/ to it.
  "services": [
    { "binding": "REGROUP", "service": "regroup" },
    { "binding": "SNAP", "service": "snap-split" },
    { "binding": "DOUBLES", "service": "doubles" },
    { "binding": "GRAMMAR", "service": "grammar" },
    { "binding": "FRACTIONS", "service": "fractions" },
    { "binding": "LETTERS", "service": "letters" },
    { "binding": "READALOUD", "service": "readaloud" },
    { "binding": "WATCH", "service": "watch" },
    { "binding": "ARTICULATE", "service": "articulation" },
    { "binding": "CANDLES", "service": "candles" },
    { "binding": "USHER", "service": "usher" },
    { "binding": "PORTER", "service": "porter" }
  ],
  // Family codes and daily safety caps, shared with the app Workers (worker/codes.js).
  // The admin page (/admin/) needs a secret: npx wrangler secret put ADMIN_KEY
  "kv_namespaces": [{ "binding": "CODES", "id": "a39d9bda676b420394c3eaba35975dec" }],
  // The Angelio Studio (worker/studio.js): Watch & Sing's library, its history and uploads, in the media bucket.
  "r2_buckets": [{ "binding": "WATCH_MEDIA", "bucket_name": "watch-media" }],
  // Nightly Studio backup to GitHub, 3:47 am Central (needs the GITHUB_TOKEN secret).
  "triggers": { "crons": ["47 9 * * *"] },
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "angelio.org", "custom_domain": true }]
}
