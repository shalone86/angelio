{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "angelio",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Each app is its own Worker; the hub forwards angelio.org/<path>/ to it.
  "services": [
    { "binding": "REGROUP", "service": "regroup" },
    { "binding": "SNAP", "service": "snap-split" },
    { "binding": "DOUBLES", "service": "doubles" },
    { "binding": "GRAMMAR", "service": "grammar" },
    { "binding": "FRACTIONS", "service": "fractions" },
    { "binding": "ARTICULATE", "service": "articulation" }
  ],
  // Family codes and daily safety caps, shared with the app Workers (worker/codes.js).
  // The admin page (/admin/) needs a secret: npx wrangler secret put ADMIN_KEY
  "kv_namespaces": [{ "binding": "CODES", "id": "a39d9bda676b420394c3eaba35975dec" }],
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [{ "pattern": "angelio.org", "custom_domain": true }]
}
